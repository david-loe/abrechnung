{
  "entryFile": "./app.ts",
  "noImplicitAdditionalProperties": "silently-remove-extras",
  "controllerPathGlobs": ["controller/**/*Controller.ts"],
  "spec": {
    "outputDirectory": "dist",
    "specVersion": 3,
    "securityDefinitions": {
      "httpBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "cookieAuth": {
        "type": "apiKey",
        "name": "abrechnung",
        "in": "cookie",
        "description": "Cookie-authenticated writes require an exact trusted Origin and X-CSRF-Token from GET /auth/csrf."
      }
    }
  },
  "routes": {
    "routesDir": "dist",
    "esm": true,
    "authenticationModule": "controller/authentication.ts"
  }
}
