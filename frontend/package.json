{
  "name": "abrechnung-frontend",
  "version": "2.6.4",
  "private": true,
  "type": "module",
  "exports": {
    "./*": "./*"
  },
  "scripts": {
    "dev": "vite & vue-tsc --noEmit --watch",
    "build": "vue-tsc --noEmit && vite build && npm run check:bundle",
    "check:bundle": "node scripts/check-bundle-budgets.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@vueform/vueform": "^1.13.13",
    "abrechnung-common": "file:../common",
    "axios": "^1.18.1",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "chart.js": "^4.5.1",
    "idb": "^8.0.3",
    "json-editor-vue": "^0.18.1",
    "qrcode": "^1.5.4",
    "qs": "^6.15.3",
    "simple-code-editor": "^2.1.0",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.7",
    "vue-router": "^5.2.0",
    "vue-select": "^4.0.0-beta.6",
    "vue-to-print": "^1.5.1",
    "vue3-easy-data-table": "^1.5.47"
  },
  "devDependencies": {
    "@types/bootstrap": "^5.2.11",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/qs": "^6.15.1",
    "@types/vue-select": "^3.16.8",
    "@vitejs/plugin-vue": "^6.0.8",
    "fake-indexeddb": "^6.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.3.8"
  },
  "overrides": {
    "vite-plugin-pwa": {
      "vite": "$vite"
    }
  },
  "browserslist": ["> 1%", "last 2 versions", "not dead"]
}
